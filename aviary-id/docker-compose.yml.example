services:
  aviary-id:
    build: .
    image: aviary-id:latest
    container_name: aviary-id
    restart: unless-stopped
    ports:
      # Reachable from the Home Assistant host. Bind to a specific interface
      # (e.g. "10.0.0.50:8100:8100") if this box has a public NIC.
      - "8100:8100"
    volumes:
      # Model weights, the eBird caches, and the text-embedding cache. Without this,
      # every container recreate re-downloads ~2 GB and re-encodes the vocabulary.
      - aviary-id-models:/models
    environment:
      # --- required ---------------------------------------------------------------
      # This host must be able to reach Frigate directly; it pulls clips itself rather
      # than having them proxied through Home Assistant.
      FRIGATE_URL: "http://frigate.lan:5000"

      # --- strongly recommended ---------------------------------------------------
      # Shared secret Aviary sends as `Authorization: Bearer ...`. Must match the
      # add-on's identify_token option. Blank disables auth.
      AVIARY_ID_TOKEN: ""
      # Free key from https://ebird.org/api/keygen. Without BOTH of these the service
      # falls back to a generic North American yard-bird list and accuracy drops.
      EBIRD_API_KEY: ""
      # County is best (e.g. US-CO-013); state (US-CO) and country (US) also work.
      EBIRD_REGION: ""

      # --- tuning (defaults shown) ------------------------------------------------
      # TRAINED_CLASSIFIER: "aiy"     # supervised primary: aiy (Frigate's bird model,
      #                               # CPU), inat21 (timm EVA02 iNat21 fine-tune, GPU,
      #                               # ~1.2 GB VRAM, markedly more accurate), auto
      #                               # (inat21 iff CUDA), none (zero-shot only, for A/B)
      # TRAINED_MODEL: "timm/eva02_large_patch14_clip_336.merged2b_ft_inat21"
      #                               # HF checkpoint behind inat21 (cc-by-nc-4.0)
      # TRAINED_BATCH: "4"            # crops per inat21 forward pass
      # TRAINED_WEIGHT: "0.75"        # its share of the mix for species it knows
      # TRAINED_ACCEPT: "0.65"        # best-frame confidence at which its verdict
      #                               # wins outright (not averaged away)
      # SAMPLE_FRAMES: "8"            # frames decoded from the clip before filtering
      # CLASSIFY_FRAMES: "4"          # best frames actually classified
      # DETECTOR_BACKEND: "yolo"      # yolo (better on small/shaded birds, AGPL-3.0)
      #                               # or frcnn (torchvision, BSD-3)
      # DETECTOR_MODEL: "yolo11n.pt"  # yolo11s.pt/yolo11m.pt find more small, far birds
      # DETECTOR_IMGSZ: "640"         # 960/1280 helps feeder-distance birds (more VRAM)
      # DETECTOR_THRESHOLD: "0.3"     # min score for a box to count as a bird
      # CROP_PADDING: "0.15"          # context added around the bird before cropping
      # EXTRA_SPECIES: "Painted Bunting,Bobolink"
      # EXCLUDE_SPECIES: "Rock Pigeon"
      # CPU_ONLY: "1"                 # skip the GPU entirely (~5s/event, useful for tests)

      # --- suggested profile for an 8 GB card (e.g. GTX 1070), sidecar-exclusive ---
      # TRAINED_CLASSIFIER: "inat21"  # measure first with tools/smoke_test.py --labels
      # DETECTOR_MODEL: "yolo11s.pt"
      # DETECTOR_IMGSZ: "960"

      # --- accuracy tuning --------------------------------------------------------
      # How each species is described to the model. This is the biggest lever on telling
      # apart species WITHIN a family (cardinal vs. tanager), and worth A/B-ing against
      # birds you can name yourself. Each format caches separately, so switching back and
      # forth only pays the encode cost once per format.
      #   common          "Northern Cardinal"                      (default)
      #   binomial        "Cardinalis cardinalis"
      #   binomial_common "Cardinalis cardinalis (Northern Cardinal)"
      #   taxonomy        the full rank chain — NOT recommended: every species in a family
      #                   shares most of the string, which swamps what distinguishes them
      # LABEL_FORMAT: "common"
      # NO_PROMPT_ENSEMBLE: "1"   # single prompt instead of the 80-template average

      # --- if the GPU is shared and you hit out-of-memory ------------------------
      # Check `nvidia-smi` first — this container needs roughly 1.3 GB free (about
      # 2.5 GB with TRAINED_CLASSIFIER=inat21), and the error message names every
      # process holding memory on the card. Then, in escalating order of what you
      # give up:
      # TRAINED_CLASSIFIER: "aiy"     # supervised primary back on the CPU
      # DETECTOR_BATCH: "1"           # fewer frames through the detector at once
      # DETECTOR_CPU: "1"             # detector on CPU, classifier stays on the GPU
      # CLASSIFY_FRAMES: "2"          # fewer crops per event
      # SAMPLE_FRAMES: "5"            # fewer frames decoded from the clip
      # MODEL_NAME: "hf-hub:imageomics/bioclip"   # ViT-B/16: ~4x smaller than bioclip-2,
      #                                           # less accurate, still far better than
      #                                           # Frigate's built-in classifier
      LOG_LEVEL: "info"
      TZ: "America/Denver"

    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]

volumes:
  aviary-id-models:
